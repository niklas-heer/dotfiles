ObjC.import("Foundation");

function guessLanguage(input) {
  return $.NSLinguisticTagger.dominantLanguageForString($(input)).js;
}

function speak(text) {
  const language = guessLanguage(text);
  const app = Application.currentApplication();
  app.includeStandardAdditions = true;

  if (language === "en" || language === "und") {
    app.say(text, { using: "Jamie (Premium)", speakingRate: 250 });
  } else if (language === "de") {
    app.say(text, { using: "Anna (Premium)", speakingRate: 250 });
  } else {
    throw new Error(`Unsupported language: ${language}`);
  }
}

function run(arguments) {
  if (arguments.length === 0 || arguments[0] === "") {
    throw new Error("Please provide text to speak.");
  }

  speak(arguments[0]);
}
