np() {
  local cd_file
  cd_file="$(mktemp -t np-cd.XXXXXX)" || return 1

  NP_CD_FILE="$cd_file" command np "$@"
  local exit_code=$?

  if [[ -f "$cd_file" ]]; then
    local destination
    destination="$(<"$cd_file")"
    rm -f "$cd_file"

    if [[ $exit_code -eq 0 && -n "$destination" && -d "$destination" ]]; then
      cd "$destination" || return $exit_code
    fi
  fi

  return $exit_code
}

