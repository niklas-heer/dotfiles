# Interactive zsh. PATH and environment live in ~/.zprofile; this file only
# sets up the session and keeps startup cheap: tools that print an init
# snippet are cached to a file instead of being run at every prompt.

# A non-login shell started from a bare environment still needs ~/.zprofile.
(( $path[(I)/opt/homebrew/bin] )) || source ~/.zprofile

fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

# zsh-autocomplete runs compinit and must load before anything calls compdef.
# Its recent-dirs history lives in a folder it never creates itself.
mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/zsh"
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

# IDE-style menu, in the spirit of inshellisense: a compact list with
# descriptions appears as you type, Tab inserts the top match, arrows enter the
# menu, Tab inside the menu cycles, Enter accepts. Selection uses the Tokyo
# Night selection colour.
zstyle ':autocomplete:*:*' list-lines 10
zstyle ':autocomplete:history-incremental-search-backward:*' list-lines 16
zstyle ':completion:*' verbose yes
zstyle ':completion:*:default' list-colors 'di=1;34' 'ln=36' 'ex=32' 'ma=48;2;51;70;124;1'
bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete

# Source the cached output of `<tool> init zsh`, regenerating it when the
# binary's resolved path changes (Homebrew upgrade) or the binary is newer.
#   zsh-init-cache <name> <command> [args...]
typeset -g ZSH_INIT_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init"
zsh-init-cache() {
  local name=$1; shift
  local bin=${commands[$1]}
  [[ -n $bin ]] || return 0
  local cache=$ZSH_INIT_CACHE_DIR/$name.zsh key="# ${bin:A}" first=
  [[ -s $cache ]] && read -r first < "$cache"
  if [[ $first != $key || $bin -nt $cache ]]; then
    mkdir -p "$ZSH_INIT_CACHE_DIR"
    { print -r -- "$key"; "$@" } >| "$cache" 2>/dev/null || { rm -f "$cache"; return 1 }
  fi
  source "$cache"
}

# Carapace feeds completions for many CLIs into the zsh-autocomplete menu.
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zsh-init-cache carapace carapace _carapace
# Keep zsh's own git completion: it lists common commands first and knows
# branches and commits, whereas Carapace's groups come out alphabetically.
compdef _git git

# Prompt
export VIRTUAL_ENV_DISABLE_PROMPT=1
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
zsh-init-cache oh-my-posh oh-my-posh init zsh --config ~/.nheer.omp.yaml --print

zsh-init-cache zoxide zoxide init zsh
zsh-init-cache atuin atuin init zsh
zsh-init-cache wtp wtp shell-init zsh
# repot owns repository navigation and follows successful directory handoffs.
zsh-init-cache repot repot shell-init zsh
zsh-init-cache repot-completions repot completions zsh
# television: Ctrl-T picks from channels, Ctrl-R replaces atuin's history search.
zsh-init-cache tv tv init zsh

# Workflow helpers (np, nht, homelab-*) are autoloaded on first use.
fpath=(~/.config/zsh/functions $fpath)
autoload -Uz ~/.config/zsh/functions/*(.:t)

HOMELAB_OP_ACCOUNT="my.1password.com"
